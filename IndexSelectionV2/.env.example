# Read-only DSNs. Never commit the real file.
ISEL_CRAWLERDB_DSN=postgresql://USER:PASS@172.16.191.1:5432/crawlerdb
ISEL_METRICDB_DSN=postgresql://USER:PASS@172.16.191.1:5433/metricdb
# Our selectdb (:5445), milestone 2 only. In the container each variable is a
# secret file instead: set <NAME>_FILE=/run/secrets/<file> (DESIGN §12.4).
ISEL_SELECTDB_ADMIN_DSN=postgresql://idxsel_admin:PASSWORD@172.16.191.1:5445/selectdb
ISEL_SELECTDB_READER_DSN=postgresql://select:PASSWORD@172.16.191.1:5445/selectdb
ISEL_SELECTDB_READER_PASSWORD=PASSWORD
