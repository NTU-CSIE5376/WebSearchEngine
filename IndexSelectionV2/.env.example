# Copy to .env (chmod 600). Never commit .env.
IDXSEL_CRAWLERDB_DSN=postgresql://crawler:CHANGE_ME@172.16.191.1:5432/crawlerdb
IDXSEL_METRICDB_DSN=postgresql://metric:CHANGE_ME@172.16.191.1:5433/metricdb
IDXSEL_SELECTDB_ADMIN_DSN=postgresql://idxsel_admin:CHANGE_ME@172.16.191.1:5445/selectdb
# The official metric connects as select/<hardcoded password> (measure.py:104-106).
IDXSEL_SELECTDB_READER_DSN=postgresql://select:CHANGE_ME@172.16.191.1:5445/selectdb
# Only `idxsel init-selectdb` needs this; the daemon does not.
IDXSEL_SELECTDB_READER_PASSWORD=CHANGE_ME
