# December 2026 course schedule (docs/03-dockerfile-operations.md, "Course schedule").
# Select it with METRIC_CRONTAB=crontab.course-202612. It replaces the default golden
# jobs: Metric/deploy/course/run_golden.py runs the Dec 1, 8 and 15 batches and keeps its
# phase state in GOLDEN_COURSE_STATE. Schedules run in UTC; the runner works in Taipei time.

# 每小時執行一次 (Status)
0 * * * * cd /root/WebSearchEngine && /root/system-venv/bin/python3 measure.py --test --metric_db_url 172.16.191.1:5433 --crawler_db_url 172.16.191.3:5433 --measure status
0 * * * * cd /root/WebSearchEngine && /root/system-venv/bin/python3 migrate.py

# 12/1、12/8、12/15 台灣時間 08:00-19:45：runner 依 phase 狀態決定要不要跑
0,5,15,30,45 0-11 1,8,15 12 * umask 077 && /usr/bin/timeout -k 15s 4h /root/system-venv/bin/python3 -u /root/WebSearchEngine/Metric/deploy/course/run_golden.py
