# Schedules run in UTC (TZ=UTC in docker-compose.yml). supercronic runs each line with /bin/sh -c;
# jobs inherit the container env, so SERPAPI_KEY comes from metric.env, and output goes to docker logs.

# 每小時執行一次 (Status)
0 * * * * cd /root/WebSearchEngine && /root/system-venv/bin/python3 measure.py --test --metric_db_url 172.16.191.1:5433 --crawler_db_url 172.16.191.3:5433 --measure status
0 * * * * cd /root/WebSearchEngine && /root/system-venv/bin/python3 migrate.py

# 每月 1 號與 16 號 中午 12 點 (Strategy: random)
0 12 1,16 * * cd /root/WebSearchEngine && /root/system-venv/bin/python3 measure.py --create --metric_db_url 172.16.191.1:5433 --crawler_db_url 172.16.191.3:5433 --select_db_url 172.16.191.1:5445 --strategy random --keywordNums 1000 --test --measure crawler_all

# 每月 1 號與 16 號 下午 6 點 (Strategy: head)
0 18 1,16 * * cd /root/WebSearchEngine && /root/system-venv/bin/python3 measure.py --create --metric_db_url 172.16.191.1:5433 --crawler_db_url 172.16.191.3:5433 --select_db_url 172.16.191.1:5445 --strategy head --keywordNums 1000 --test --measure crawler_all
